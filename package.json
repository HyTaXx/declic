{
  "name": "declic",
  "description": "Anonymous addiction screening and resource navigation platform for students",
  "type": "module",
  "private": true,
  "packageManager": "npm@11.8.0",
  "workspaces": [
    "apps/frontend",
    "packages/*"
  ],
  "scripts": {
    "build": "turbo run build",
    "dev": "turbo run dev --parallel",
    "lint": "turbo run lint",
    "lint:fix": "turbo run lint:fix",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "test": "turbo run test",
    "frontend:dev": "npm run dev --workspace @declic/frontend",
    "frontend:preview": "npm run preview --workspace @declic/frontend"
  },
  "devDependencies": {
    "prettier": "^3.8.1",
    "turbo": "^2.9.14"
  }
}
