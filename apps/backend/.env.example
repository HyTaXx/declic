# Local from host machine (backend outside Docker)
DATABASE_URL=postgresql://declic:declic@localhost:5432/declic
# Local in Docker Compose (backend container -> db service)
# DATABASE_URL=postgresql://declic:declic@db:5432/declic

# Production (Supabase) — Project Settings → Database → Connection string → URI
# Use "Transaction" pooler (port 6543) for the API
# DATABASE_URL=postgresql://postgres.[project-ref]:[password]@aws-0-eu-central-1.pooler.supabase.com:6543/postgres
RESEND_API_KEY=re_your_api_key_here
# Optional — defaults to onboarding@resend.dev (change to a verified domain in prod)
MAIL_FROM=onboarding@resend.dev
# Optional — defaults to "Vos résultats Déclic"
MAIL_SUBJECT=Vos résultats Déclic
# Optional — comma-separated; defaults to * (all origins)
ALLOWED_ORIGINS=http://localhost:3000,http://0.0.0.0:3000,http://127.0.0.1:3000,https://yourdomain.com
